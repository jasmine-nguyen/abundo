      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-item ds-seg-on\">This cycle</button><button class=\"ds-seg-item\">Last cycle</button></div>",
      "css": ".ds-seg{display:flex;gap:3px;padding:3px;background:#1f2030;border:1px solid rgba(122,162,247,.1);border-radius:14px;max-width:360px}.ds-seg-item{flex:1;padding:9px;border:none;border-radius:11px;background:transparent;color:#8f97c0;font:600 14px Inter,system-ui,sans-serif;cursor:pointer}.ds-seg-on{background:rgba(124,140,255,.16);color:#c0caf5;font-weight:700}.ds-seg-item:focus-visible{outline:2px solid #7aa2f7;outline-offset:1px}"
