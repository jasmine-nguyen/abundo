    {
      "name": "Transaction Row",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "Merchant, category and amount with a pending tag.",
      "html": "<div class=\"ds-tx\"><span class=\"ds-tx-chip\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff9e64\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 8.5h12v4.5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z\"/><path d=\"M16 9.5h2a2.2 2.2 0 0 1 0 4.4h-2\"/><path d=\"M7 3v2M11 3v2\"/></svg></span><div class=\"ds-tx-body\"><div class=\"ds-tx-merchant\">Market Lane Coffee</div><div class=\"ds-tx-meta\"><span style=\"color:#ff9e64\">Coffee</span><span class=\"ds-tx-pending\">Pending</span></div></div><div class=\"ds-tx-amt\">-$5.50</div></div>",
      "css": ".ds-tx{display:flex;align-items:center;gap:13px;padding:13px 6px;border-bottom:1px solid rgba(122,162,247,.1);font-family:Inter,system-ui,sans-serif;max-width:360px}.ds-tx:active{opacity:.6}.ds-tx-chip{width:42px;height:42px;border-radius:13px;background:rgba(255,158,100,.15);display:flex;align-items:center;justify-content:center}.ds-tx-body{flex:1}.ds-tx-merchant{font-size:15px;font-weight:600;color:#d5daf5}.ds-tx-meta{display:flex;gap:6px;align-items:center;margin-top:3px;font-size:12.5px}.ds-tx-pending{background:rgba(255,255,255,.06);border-radius:6px;padding:2px 7px 2px 5px;font-size:11px;color:#8b8b95}.ds-tx-amt{font:700 16px 'Inter Tight',Inter,sans-serif;letter-spacing:-.3px;color:#d5daf5}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Floating five-tab bar; hides on scroll.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\">Budgets</a><a class=\"ds-tab\">Transactions<i class=\"ds-dot\"></i></a><a class=\"ds-tab\">Accounts</a><a class=\"ds-tab\">Insights</a><a class=\"ds-tab\">Goals</a></nav>",
      "css": ".ds-tabs{display:flex;justify-content:space-around;padding:10px 8px 14px;background:#16161e;border-top:1px solid rgba(122,162,247,.1);max-width:390px}.ds-tab{position:relative;flex:1;text-align:center;font:600 10.5px Inter,system-ui,sans-serif;color:#565f89;padding-top:28px;cursor:pointer;transition:opacity .1s,transform .1s}.ds-tab::before{content:'';position:absolute;top:0;left:50%;margin-left:-11px;width:22px;height:22px;border-radius:6px;border:1.9px solid currentColor;box-sizing:border-box}.ds-tab:active{opacity:.55;transform:scale(.92)}.ds-tab-on{color:#7aa2f7}.ds-dot{position:absolute;top:-3px;left:calc(50% + 6px);width:8px;height:8px;border-radius:4px;background:#f7768e;border:2px solid #16161e}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Glow",
    "overview": "Abundo is a dim, restful room with a few lights on. Almost everything sits in deep Tokyo Night navy, in soft lavender-grey ink, at low contrast to its neighbours, so a glance at night never glares. Against that quiet, a handful of moments are allowed to shine: the blue-to-lilac hero card at the top of a screen, the cyan \"under budget\" number, the confetti when a milestone lands. Their brightness is the reward, and it only works because everything else stays dim.\n\nThe feel is calm first, rewarding second. Density is moderate: generous card padding (16\u201324pt), rows that breathe, one big number per screen. Shapes are soft and friendly \u2014 every surface is rounded (14\u201326pt), outlined with a faint blue hairline rather than lifted by a shadow. Motion is short and springy and always gives way to \"reduce motion\".",
    "keyCharacteristics": [
      "Dark-only Tokyo Night palette; layering by slightly lighter navy, never by shadow.",
      "One saturated gradient surface per screen (the hero card), carrying the screen's one big number.",
      "Soft rounded geometry throughout, from 7pt checkboxes to 26pt hero cards.",
      "Inter Tight for numbers and titles, Inter for everything else.",
      "Colour carries meaning: cyan = on track, rose = over, amber = a non-budget heads-up, green = surplus."
    ],
    "rules": [
      {
        "name": "The One Tint Rule",
        "body": "Tokyo Blue means \"you can tap this\" or \"this is selected\". It never decorates. Soft calls-to-action use the Periwinkle Wash instead.",
        "section": "colors"
      },
      {
        "name": "The One Glow Rule",
        "body": "Only one gradient hero card per screen. If two surfaces are both shouting, the screen is no longer quiet.",
        "section": "colors"
      },
      {
        "name": "The Derive-Don't-Copy Rule",
        "body": "Hairlines and the gradient's first stop are built from the accent with `tint()`. A new accent-derived shade derives too; it never hard-codes a second copy of the hex.",
        "section": "colors"
      },
      {
        "name": "The Numbers-Wear-Tight Rule",
        "body": "Money and counts are set in Inter Tight with negative tracking; words are set in Inter. A dollar figure in Inter, or a sentence in Inter Tight, reads off-brand.",
        "section": "typography"
      },
      {
        "name": "The Heavy-Is-Rare Rule",
        "body": "Weight 800 is reserved for hero figures. Everything else lives at 600\u2013700.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Cards, rows, sheets and fields never cast shadows. A shadow is reserved for something that floats above scrolling content.",
        "section": "elevation"
      }
    ],
    "dos": [
