      "css": ".ds-btn-primary{width:100%;min-height:53px;padding:16px;border:none;border-radius:15px;background:#7aa2f7;color:#16161e;font:700 16px Inter,system-ui,sans-serif;transition:opacity .12s,transform .12s;cursor:pointer}.ds-btn-primary:active{opacity:.85;transform:scale(.96)}.ds-btn-primary:focus-visible{outline:2px solid #c0caf5;outline-offset:3px}"
