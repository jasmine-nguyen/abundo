      "kind": "button",
      "refersTo": "button-soft",
      "description": "Add / retry / suggest actions in the Periwinkle Wash material.",
      "html": "<button class=\"ds-btn-wash\">+ New category</button>",
      "css": ".ds-btn-wash{width:100%;padding:14px;border-radius:14px;border:1px dashed rgba(124,140,255,.22);background:rgba(124,140,255,.1);color:#7c8cff;font:700 15px Inter,system-ui,sans-serif;cursor:pointer;transition:opacity .12s}.ds-btn-wash:active{opacity:.6}.ds-btn-wash:focus-visible{outline:2px solid #7c8cff;outline-offset:3px}"
    },
    {
      "name": "Hero Card",
      "kind": "custom",
      "refersTo": "hero-card",
      "description": "The one bright gradient surface per screen, holding its single big number.",
      "html": "<div class=\"ds-hero\"><span class=\"ds-hero-b1\"></span><span class=\"ds-hero-b2\"></span><div class=\"ds-hero-eyebrow\">Days left this cycle</div><div><span class=\"ds-hero-num\">9</span> <span class=\"ds-hero-unit\">days</span></div><div class=\"ds-hero-bottom\"><div><div class=\"ds-hero-small\">Left to spend</div><div class=\"ds-hero-head\">$1,284</div></div><div class=\"ds-hero-pill\"><div class=\"ds-hero-small\">Payday</div><div class=\"ds-hero-pillb\">Thu 9 Oct</div></div></div></div>",
      "css": ".ds-hero{position:relative;overflow:hidden;border-radius:26px;padding:26px 24px 22px;background:linear-gradient(150deg,#7aa2f7 0%,#8b8ff5 55%,#bb9af7 100%);color:#16161e;font-family:Inter,system-ui,sans-serif;max-width:360px}.ds-hero-b1{position:absolute;right:-30px;top:-30px;width:150px;height:150px;border-radius:75px;background:rgba(255,255,255,.12)}.ds-hero-b2{position:absolute;right:34px;bottom:-46px;width:90px;height:90px;border-radius:45px;background:rgba(255,255,255,.08)}.ds-hero-eyebrow{font-size:13px;font-weight:600;color:rgba(20,18,50,.65);letter-spacing:.2px}.ds-hero-num{font:800 54px/1 'Inter Tight',Inter,sans-serif;letter-spacing:-2px}.ds-hero-unit{font-size:17px;font-weight:600;color:#1a1b26}.ds-hero-bottom{margin-top:18px;display:flex;align-items:flex-end;justify-content:space-between}.ds-hero-small{font-size:13px;font-weight:600;color:rgba(20,18,50,.6)}.ds-hero-head{font:800 30px 'Inter Tight',Inter,sans-serif;letter-spacing:-1px;margin-top:2px}.ds-hero-pill{text-align:right;background:rgba(21,18,58,.12);border-radius:12px;padding:8px 12px}.ds-hero-pillb{font-size:13px;font-weight:700;margin-top:2px}"
    },
    {
      "name": "Budget Row Card",
      "kind": "card",
      "refersTo": "card-budget-row",
      "description": "A category budget with posted and pending on one bar, with a where-you-should-be tick.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-top\"><span class=\"ds-chip\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9ece6a\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"20\" r=\"1.3\"/><circle cx=\"17\" cy=\"20\" r=\"1.3\"/><path d=\"M3 4h2l2.1 11.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.2L20 8H6.2\"/></svg></span><div class=\"ds-card-name\">Groceries<div class=\"ds-card-meta\">$238 of $300 spent</div></div><div class=\"ds-card-right\"><div class=\"ds-card-amt\">$62</div><div class=\"ds-card-lbl\">left</div></div></div><div class=\"ds-track\"><span class=\"ds-posted\"></span><span class=\"ds-pending\"></span><span class=\"ds-tick\"></span></div></div>",
      "css": ".ds-card{background:#1f2030;border:1px solid rgba(122,162,247,.1);border-radius:20px;padding:16px 16px 14px;font-family:Inter,system-ui,sans-serif;max-width:360px}.ds-card-top{display:flex;align-items:center;gap:13px;margin-bottom:12px}.ds-chip{width:42px;height:42px;border-radius:13px;background:rgba(158,206,106,.15);display:flex;align-items:center;justify-content:center}.ds-card-name{flex:1;font-size:16px;font-weight:600;letter-spacing:-.2px;color:#d5daf5}.ds-card-meta{font-size:13px;color:#8f97c0;margin-top:2px}.ds-card-right{text-align:right}.ds-card-amt{font:700 20px 'Inter Tight',Inter,sans-serif;letter-spacing:-.5px;color:#2ac3de}.ds-card-lbl{font-size:12px;font-weight:500;color:#8f97c0;margin-top:1px}.ds-track{position:relative;height:10px;border-radius:6px;background:rgba(255,255,255,.07)}.ds-posted{position:absolute;left:0;top:0;bottom:0;width:62%;border-radius:6px 0 0 6px;background:#9ece6a}.ds-pending{position:absolute;left:62%;top:0;bottom:0;width:14%;background:rgba(158,206,106,.4)}.ds-tick{position:absolute;left:70%;top:0;width:2px;height:13px;border-radius:1px;background:#fff}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
