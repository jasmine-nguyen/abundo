{
  "permissions": {
    "allow": [
      "Bash(aws sts get-caller-identity)",
      "Bash(aws dynamodb query *)",
      "Bash(aws dynamodb get-item *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws logs tail *)",
      "WebFetch(domain:api.banksync.io)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-setup.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
