{
  "name": "abundo-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/dev.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "TZ=Australia/Melbourne jest --selectProjects logic --maxWorkers=2",
    "test:screen": "TZ=Australia/Melbourne jest --selectProjects screen --workerIdleMemoryLimit=512MB",
    "test:all": "TZ=Australia/Melbourne jest --workerIdleMemoryLimit=512MB",
    "coverage:local": "bash scripts/coverage-run-local.sh",
    "coverage:check": "node scripts/coverage-merge-check.js",
    "typecheck": "tsc --noEmit",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tanstack/react-query": "5.101.2",
    "amazon-cognito-identity-js": "^6.3.12",
    "expo": "~58.0.17",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "private": true,
  "//async-storage": "@react-native-async-storage/async-storage stores the Ask Abundo consent (src/chat/ChatContext.tsx), and amazon-cognito-identity-js also needs it at runtime to persist sessions. Keep it. expo.install.exclude keeps it on v3 because Expo 58 pins 2.2.0, which would lose that saved data, so the exclusion must stay.",
  "//overrides": "jest-expo 58 and @react-native/jest-preset both use jest 30, but npm mixes patch levels, so force one jest 30 toolchain so the runtime/mock/env versions agree. expo-router 58 lists @testing-library/react-native 14 as an optional peer; the expo-router entry keeps us on 13, because 14 makes render/fireEvent async across every screen test.",
  "overrides": {
    "jest": "30.4.1",
    "jest-cli": "30.4.1",
    "@jest/core": "30.4.1",
    "@jest/globals": "30.4.1",
    "jest-mock": "30.4.1",
    "jest-runtime": "30.4.1",
    "jest-resolve": "30.4.1",
    "jest-snapshot": "30.4.1",
    "jest-config": "30.4.1",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "30.4.1",
    "expect": "30.4.1",
    "expo-router": {
      "@testing-library/react-native": "$@testing-library/react-native"
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "~19.3.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "30.4.1",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  }
}
